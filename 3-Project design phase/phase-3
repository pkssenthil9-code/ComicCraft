<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ComicCraft - Project Design</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f3ff;
      color: #2e1065;
    }
    header {
      background: #5b21b6;
      color: white;
      text-align: center;
      padding: 22px;
    }
    nav {
      background: white;
      padding: 15px;
      text-align: center;
    }
    nav a {
      color: #5b21b6;
      text-decoration: none;
      margin: 0 12px;
      font-weight: bold;
    }
    main {
      max-width: 750px;
      margin: 25px auto;
      padding: 15px;
    }
    .card {
      background: white;
      padding: 22px;
      margin-bottom: 18px;
      border-radius: 14px;
      box-shadow: 0 3px 12px #0001;
    }
    textarea, select {
      width: 100%;
      padding: 12px;
      margin-top: 8px;
      border: 1px solid #c4b5fd;
      border-radius: 8px;
      font: inherit;
    }
    button {
      background: #6d28d9;
      color: white;
      border: none;
      border-radius: 8px;
      padding: 12px 18px;
      margin-top: 15px;
      cursor: pointer;
    }
    #output {
      background: #f5f3ff;
      padding: 15px;
      border-radius: 8px;
      line-height: 1.7;
    }
  </style>
</head>
<body>
  <header>
    <h1>🎨 ComicCraft</h1>
    <p>AI Comic Story Creator using Gemini Models</p>
  </header>

  <nav>
    <a href="#home">Home</a>
    <a href="#create">Create Story</a>
    <a href="#about">About</a>
  </nav>

  <main id="home">
    <section class="card">
      <h2>Project Design</h2>
      <p>Create your own comic story idea using this demo interface.</p>
    </section>

    <section class="card" id="create">
      <h2>✨ Create Your Comic</h2>

      <label for="genre">Choose a Genre</label>
      <select id="genre">
        <option>Adventure</option>
        <option>Fantasy</option>
        <option>Comedy</option>
        <option>Science Fiction</option>
        <option>Mystery</option>
      </select>

      <label for="prompt">Enter Your Story Idea</label>
      <textarea id="prompt" rows="4"
        placeholder="Example: A student discovers a magical book..."></textarea>

      <button onclick="previewStory()">Preview Story Idea</button>

      <div id="output" aria-live="polite">
        Your story preview will appear here.
      </div>
    </section>

    <section class="card" id="about">
      <h2>About ComicCraft</h2>
      <p>ComicCraft is designed to help users turn creative
      prompts into comic-style stories with AI assistance.</p>
    </section>
  </main>

  <script>
    function previewStory() {
      const genre = document.getElementById("genre").value;
      const prompt = document.getElementById("prompt").value.trim();
      const output = document.getElementById("output");

      if (!prompt) {
        output.textContent = "Please enter your story idea first.";
        return;
      }

      const heading = document.createElement("h3");
      heading.textContent = genre + " Story Preview";

      const paragraph = document.createElement("p");
      paragraph.textContent = prompt;

      output.replaceChildren(heading, paragraph);
    }
  </script>
</body>
</html>
